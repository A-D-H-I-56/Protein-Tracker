# ==============================================================================
# NutriAI Environment Configuration
# Copy this file to .env and adjust variables as needed
# ==============================================================================

# Application Environment & Security
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=nutriai-production-super-secret-key-2026

# Server Network & Concurrency
HOST=0.0.0.0
PORT=5000
THREADS=4

# Paths & File Storage
ARTIFACTS_DIR=artifacts
DATASET_PATH=Fitness_data.csv

# Machine Learning Engine & Training Hyperparameters
KNN_NEIGHBORS=5
KNN_METRIC=euclidean
KNN_WEIGHTS=distance
TRAIN_SPLIT_RATIO=0.6
RANDOM_STATE=42
TOP_K_EXPLAIN_DEFAULT=3

# Validation Boundaries
MIN_AGE=15
MAX_AGE=100
MIN_WEIGHT=40.0
MAX_WEIGHT=200.0
MIN_HEIGHT=140.0
MAX_HEIGHT=220.0

# Target Value Safety Bounds
MIN_CALORIES=800
MAX_CALORIES=6000
MIN_PROTEIN=30
MAX_PROTEIN=400
MIN_CARBS=20
MAX_CARBS=800
MIN_FAT=15
MAX_FAT=300

# Daily Meal Schedule Percentages (must sum to 1.0)
MEAL_BREAKFAST_PCT=0.25
MEAL_LUNCH_PCT=0.35
MEAL_DINNER_PCT=0.25
MEAL_SNACKS_PCT=0.15

# Permitted Categorical Domains (comma-separated)
ALLOWED_GENDERS=Male,Female
ALLOWED_ACTIVITY_LEVELS=Sedentary,Light Active,Active,Very Active
ALLOWED_GOALS=Weight Loss,Maintenance,Muscle Gain
